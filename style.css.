
/* PALETA DE CORES */
:root {
    --verde: #5D7B3D;
    --rosa: #E4568B;
    --amarelo: #F6C94D;
    --azul: #A7C7E4;
    --rosa-claro: #F29BB9;
    --vermelho: #C42B34;
    --branco: #FFFFFF;
}

/* CONFIGURAÇÕES GERAIS */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: var(--verde);
    color: var(--rosa-claro);
}

/* CABEÇALHO */
header {
    background-color: var(--vermelho);
    color: var(--branco);
    padding: 30px;
    text-align: center;
}

/* CONTEÚDO PRINCIPAL */
main {
    max-width: 900px;
    margin: 40px auto;
    padding: 30px;
    background-color: var(--amarelo);
    border-radius: 15px;
}

/* TÍTULOS */
h1 {
    font-size: 32px;
    margin-bottom: 15px;
}

h2 {
    color: var(--rosa);
    margin-bottom: 15px;
}

/* BOTÃO */
button {
    background-color: var(--azul);
    color: var(--branco);
    border: none;
    padding: 12px 25px;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 20px;
}
